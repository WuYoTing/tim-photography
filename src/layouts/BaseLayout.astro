---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../config/site";
import { defaultLocale, getLocalizedPath, type Locale } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  path: string;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
}

const { title, description, locale, path, ogImage, structuredData } = Astro.props;

const canonicalUrl = new URL(getLocalizedPath(path, locale), siteConfig.siteUrl).toString();
const enUrl = new URL(getLocalizedPath(path, "en"), siteConfig.siteUrl).toString();
const zhTwUrl = new URL(getLocalizedPath(path, "zh-tw"), siteConfig.siteUrl).toString();
const resolvedOgImage = ogImage
  ? new URL(ogImage, siteConfig.siteUrl).toString()
  : undefined;
const faviconHref = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`;
---

<!doctype html>
<html lang={locale === "zh-tw" ? "zh-TW" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-TW" href={zhTwUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <script is:inline>
      (function () {
        var stored = localStorage.getItem("theme");
        var theme =
          stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
  </head>
  <body>
    <Header locale={locale} path={path} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
