---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoGrid from "../components/PhotoGrid.astro";
import { siteConfig } from "../config/site";
import { useTranslations, pickLocalized, getLocalizedPath, type Locale } from "../i18n/utils";
import { getOgImagePath } from "../utils/og-image";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const allPhotos = (await getCollection("photos")).sort((a, b) => a.data.order - b.data.order);
const featured = allPhotos.filter((p) => p.data.featured);
const hero = featured[0] ?? allPhotos[0];

const title = `${siteConfig.name} — ${pickLocalized(siteConfig.tagline, locale)}`;
const descriptionByLocale: Record<Locale, string> = {
  en: `${siteConfig.name}, a photographer based in ${siteConfig.location}.`,
  "zh-tw": `Tim,一位在台北的攝影師。`,
};
const description = descriptionByLocale[locale];
const ogImage = hero ? await getOgImagePath(hero.data.image) : undefined;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteConfig.name,
  jobTitle: "Photographer",
  url: siteConfig.siteUrl,
  sameAs: [siteConfig.social.instagram, siteConfig.social.linkedin],
};
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  path="/"
  ogImage={ogImage}
  structuredData={structuredData}
>
  <section class="hero">
    {hero && (
      <Image
        class="hero-image"
        src={hero.data.image}
        alt={pickLocalized(hero.data.alt, locale)}
        width={1920}
        height={1280}
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="hero-overlay">
      <h1>{siteConfig.name}</h1>
      <p class="hero-tagline">{pickLocalized(siteConfig.tagline, locale)}</p>
    </div>
  </section>

  <section class="container intro">
    <p>{t("home.intro")}</p>
    <a class="learn-more" href={getLocalizedPath("/about", locale)}>{t("home.learnMore")} →</a>
  </section>

  <section class="container featured">
    <h2>{t("home.featuredHeading")}</h2>
    <PhotoGrid photos={featured} locale={locale} mode="feature-link" />
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    height: 70vh;
    min-height: 420px;
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #fff;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.15), rgba(0, 0, 0, 0.55));
    padding: var(--space-2);
  }

  .hero-overlay h1 {
    font-size: clamp(2rem, 6vw, 3.5rem);
    margin: 0 0 var(--space-1);
    letter-spacing: 0.02em;
  }

  .hero-tagline {
    margin: 0;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
  }

  .intro {
    padding-block: var(--space-5);
    max-width: 640px;
    text-align: center;
    margin-inline: auto;
  }

  .learn-more {
    display: inline-block;
    margin-top: var(--space-2);
    text-decoration: underline;
  }

  .featured {
    padding-block: var(--space-5);
  }

  .featured h2 {
    margin-bottom: var(--space-3);
  }
</style>
