---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations, pickLocalized, type Locale } from "../i18n/utils";
import { getOgImagePath } from "../utils/og-image";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const allPhotos = (await getCollection("photos")).sort((a, b) => a.data.order - b.data.order);
const portrait = allPhotos.find((p) => p.data.featured) ?? allPhotos[0];
const ogImage = portrait ? await getOgImagePath(portrait.data.image) : undefined;

const titleByLocale: Record<Locale, string> = {
  en: "About — Wu You Ting Photography",
  "zh-tw": "關於我 — Wu You Ting Photography",
};
const descriptionByLocale: Record<Locale, string> = {
  en: "Wu You Ting is a photographer based in Taipei, Taiwan.",
  "zh-tw": "吳有廷是一位台北的攝影師。",
};
---

<BaseLayout
  title={titleByLocale[locale]}
  description={descriptionByLocale[locale]}
  locale={locale}
  path="/about"
  ogImage={ogImage}
>
  <section class="container about-page">
    <h1>{t("about.heading")}</h1>

    <div class="about-layout">
      {portrait && (
        <Image
          class="about-portrait protected-image"
          src={portrait.data.image}
          alt={pickLocalized(portrait.data.alt, locale)}
          width={800}
          height={1067}
          loading="eager"
        />
      )}

      <div class="about-copy">
        <p>{t("about.bioParagraph1")}</p>
        <p>{t("about.bioParagraph2")}</p>
        <p>{t("about.bioParagraph3")}</p>

        <h2>{t("about.gearHeading")}</h2>
        <p>{t("about.gearText")}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLImageElement>(".protected-image").forEach((img) => {
    img.addEventListener("contextmenu", (e) => e.preventDefault());
    img.addEventListener("dragstart", (e) => e.preventDefault());
  });
</script>

<style>
  .about-page {
    padding-block: var(--space-4) var(--space-6);
  }

  .about-layout {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .about-portrait {
    width: 100%;
    max-width: 420px;
    height: auto;
    object-fit: cover;
  }

  .about-copy {
    max-width: 640px;
  }

  @media (min-width: 768px) {
    .about-layout {
      grid-template-columns: 380px 1fr;
      align-items: start;
    }
  }
</style>
