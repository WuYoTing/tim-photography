---
import { useTranslations, type Locale } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<div id="lightbox" class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button id="lightbox-close" class="lightbox-close" type="button">
    <span class="visually-hidden">{t("lightbox.close")}</span>
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
  </button>

  <button id="lightbox-prev" class="lightbox-nav lightbox-prev" type="button">
    <span class="visually-hidden">{t("lightbox.prev")}</span>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
      <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <figure class="lightbox-figure">
    <img id="lightbox-image" alt="" />
    <figcaption id="lightbox-caption"></figcaption>
  </figure>

  <button id="lightbox-next" class="lightbox-nav lightbox-next" type="button">
    <span class="visually-hidden">{t("lightbox.next")}</span>
    <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
      <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--color-overlay);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-figure {
    margin: 0;
    max-width: min(90vw, 1100px);
    max-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
  }

  .lightbox-figure img {
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
  }

  #lightbox-caption {
    color: #fff;
    font-size: 0.9rem;
    text-align: center;
  }

  .lightbox-close,
  .lightbox-nav {
    position: absolute;
    min-width: 44px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.35);
    border: none;
    border-radius: 50%;
    color: #fff;
    cursor: pointer;
  }

  .lightbox-close {
    top: var(--space-2);
    right: var(--space-2);
  }

  .lightbox-prev {
    left: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: var(--space-2);
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  let group: Element | null = null;
  let images: HTMLImageElement[] = [];
  let titles: string[] = [];
  let currentIndex = 0;
  let lastFocused: HTMLElement | null = null;

  const lightbox = document.getElementById("lightbox");
  const lightboxImage = document.getElementById("lightbox-image") as HTMLImageElement;
  const lightboxCaption = document.getElementById("lightbox-caption");
  const closeBtn = document.getElementById("lightbox-close");
  const prevBtn = document.getElementById("lightbox-prev");
  const nextBtn = document.getElementById("lightbox-next");

  function render() {
    const source = images[currentIndex];
    if (!source || !lightboxImage) return;
    lightboxImage.src = source.currentSrc || source.src;
    lightboxImage.alt = source.alt || "";
    if (lightboxCaption) lightboxCaption.textContent = titles[currentIndex] ?? "";
  }

  function open(groupEl: Element, index: number) {
    group = groupEl;
    images = Array.from(group.querySelectorAll<HTMLImageElement>(".lightbox-full-image"));
    titles = Array.from(
      group.querySelectorAll<HTMLElement>(".photo-lightbox-trigger")
    ).map((el) => el.dataset.title ?? "");
    currentIndex = index;
    lastFocused = document.activeElement as HTMLElement;
    render();
    lightbox?.removeAttribute("hidden");
    document.body.style.overflow = "hidden";
    closeBtn?.focus();
  }

  function close() {
    lightbox?.setAttribute("hidden", "");
    document.body.style.overflow = "";
    lastFocused?.focus();
  }

  function showNext() {
    if (images.length === 0) return;
    currentIndex = (currentIndex + 1) % images.length;
    render();
  }

  function showPrev() {
    if (images.length === 0) return;
    currentIndex = (currentIndex - 1 + images.length) % images.length;
    render();
  }

  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement)?.closest<HTMLElement>(
      ".photo-lightbox-trigger"
    );
    if (!trigger) return;
    const groupEl = trigger.closest("[data-lightbox-group]");
    const index = Number(trigger.dataset.lightboxIndex ?? "0");
    if (groupEl) open(groupEl, index);
  });

  closeBtn?.addEventListener("click", close);
  nextBtn?.addEventListener("click", showNext);
  prevBtn?.addEventListener("click", showPrev);

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener("keydown", (e) => {
    if (lightbox?.hasAttribute("hidden")) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowRight") showNext();
    if (e.key === "ArrowLeft") showPrev();
  });

  let touchStartX = 0;
  lightbox?.addEventListener("touchstart", (e) => {
    touchStartX = e.changedTouches[0].clientX;
  });
  lightbox?.addEventListener("touchend", (e) => {
    const deltaX = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(deltaX) > 40) {
      if (deltaX < 0) showNext();
      else showPrev();
    }
  });
</script>
